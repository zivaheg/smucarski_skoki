\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Held-out results across 203 LOOCV folds. SD is the sample standard deviation and CI is the two-sided Student-$t$ confidence interval for the mean. Maximum errors are 4.60, 4.70, 17.10, and 16.36~m in row order.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:primary}{{2}{7}{Held-out results across 203 LOOCV folds. SD is the sample standard deviation and CI is the two-sided Student-$t$ confidence interval for the mean. Maximum errors are 4.60, 4.70, 17.10, and 16.36~m in row order}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Baselines and exploratory configurations}{7}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Current Ski Jump SSM Lab website. Controls on the left alter zone-wise wind and jumper-configuration profiles. The main panel displays the resulting finite-horizon path and hill geometry. The deployed page is static and executes the exported recurrence in the browser.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:website}{{3}{8}{Current Ski Jump SSM Lab website. Controls on the left alter zone-wise wind and jumper-configuration profiles. The main panel displays the resulting finite-horizon path and hill geometry. The deployed page is static and executes the exported recurrence in the browser}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Independent state--control sensitivity analysis}{8}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Representative measured and reconstructed trajectories under the measured-start condition. The columns jointly approximate the 10th, 50th, and 90th percentiles of measured $d_{\mathrm  {coord}}$ while remaining close to the median held-out trajectory error, they are not best-case selections. The lower row exposes time-progress-aligned separation that is difficult to see at the full X--Z scale. Here $d_{\mathrm  {coord}}$ is the derived coordinate displacement, not official hill-surface jump length, and $E$ is Equation~\eqref  {eq:error}.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:examples}{{4}{9}{Representative measured and reconstructed trajectories under the measured-start condition. The columns jointly approximate the 10th, 50th, and 90th percentiles of measured $d_{\mathrm {coord}}$ while remaining close to the median held-out trajectory error, they are not best-case selections. The lower row exposes time-progress-aligned separation that is difficult to see at the full X--Z scale. Here $d_{\mathrm {coord}}$ is the derived coordinate displacement, not official hill-surface jump length, and $E$ is Equation~\eqref {eq:error}}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Wind-feature sensitivity using the corrected timestamp data, the same 203 jump-level LOOCV folds, and fixed $\alpha =10$. Errors are means across held-out jumps, paired confidence intervals are two-sided Student-$t$ intervals for per-jump differences from the zone-mean model.}}{10}{table.3}\protected@file@percent }
\newlabel{tab:windfeatures}{{3}{10}{Wind-feature sensitivity using the corrected timestamp data, the same 203 jump-level LOOCV folds, and fixed $\alpha =10$. Errors are means across held-out jumps, paired confidence intervals are two-sided Student-$t$ intervals for per-jump differences from the zone-mean model}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Structural sensitivity results across the same 203 LOOCV folds. ``Overlap'' counts features appearing in both state and control vectors. Path is the mean of Equation~\eqref  {eq:error},endpoint is mean three-dimensional endpoint error.}}{10}{table.4}\protected@file@percent }
\newlabel{tab:independent}{{4}{10}{Structural sensitivity results across the same 203 LOOCV folds. ``Overlap'' counts features appearing in both state and control vectors. Path is the mean of Equation~\eqref {eq:error},endpoint is mean three-dimensional endpoint error}{table.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Stability and parameter interpretation}{10}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Mean spatial separation at matched percentages of flight progress for two models with non-overlapping state and control variables. The seven-state model predicts speed recursively, while the six-state model receives measured speed as a control. The widening gap shows speed-related error accumulating toward the endpoint.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:independent-progress}{{5}{11}{Mean spatial separation at matched percentages of flight progress for two models with non-overlapping state and control variables. The seven-state model predicts speed recursively, while the six-state model receives measured speed as a control. The widening gap shows speed-related error accumulating toward the endpoint}{figure.5}{}}
